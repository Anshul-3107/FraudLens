# FraudLens Backend Environment Configuration
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Live SMS Gateway Configuration
# -------------------------------------------------------------
# Fast2SMS (Recommended for Indian +91 numbers - Instant OTP route)
# 1. Sign up at https://www.fast2sms.com
# 2. Go to Dev API -> copy your API Authorization Key
# 3. Paste it below:
FAST2SMS_API_KEY=

# Twilio (Alternative for International / Global SMS)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
